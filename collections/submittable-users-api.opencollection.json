{
  "opencollection": "1.0.0",
  "info": {
    "name": "Submittable Assignments Users API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List submitters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://submittable-api.submittable.com/v4/users",
            "params": [
              {
                "name": "continuationToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve submitters - the people who have created accounts and sent submissions to your projects."
        },
        {
          "info": {
            "name": "Get a submitter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://submittable-api.submittable.com/v4/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single submitter's profile."
        }
      ]
    }
  ],
  "bundled": true
}