{
  "opencollection": "1.0.0",
  "info": {
    "name": "Submittable Assignments Funds API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Funds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List funds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://submittable-api.submittable.com/v4/funds"
          },
          "docs": "List the funds (budgets) used to award and disburse grants."
        }
      ]
    }
  ],
  "bundled": true
}