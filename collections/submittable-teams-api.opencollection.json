{
  "opencollection": "1.0.0",
  "info": {
    "name": "Submittable Assignments Teams API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List team members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://submittable-api.submittable.com/v4/organizations/team"
          },
          "docs": "List the organization's team members (staff and reviewers)."
        }
      ]
    }
  ],
  "bundled": true
}