{
  "opencollection": "1.0.0",
  "info": {
    "name": "Submittable Assignments Payments API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List payments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://submittable-api.submittable.com/v4/payments",
            "params": [
              {
                "name": "year",
                "value": "",
                "type": "query"
              },
              {
                "name": "month",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve payment records, filterable by period (for example year and month)."
        }
      ]
    }
  ],
  "bundled": true
}